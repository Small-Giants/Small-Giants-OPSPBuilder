{
  "name": "small-giants-opsp-builder",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "tsc",
    "test": "vitest run tests/unit",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run tests/rules\"",
    "migrate:goals": "tsx scripts/migrate-goals.ts",
    "import:workleap": "tsx scripts/import-workleap.ts",
    "functions:build": "npm --prefix functions run build",
    "emulators": "firebase emulators:start --only auth,firestore,functions",
    "deploy:hosting": "next build && firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore",
    "deploy:functions": "firebase deploy --only functions",
    "deploy": "npm run verify && next build && firebase deploy",
    "verify": "tsc --noEmit && npm run functions:build && npm test && npm --prefix functions test"
  },
  "dependencies": {
